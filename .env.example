# Collector
DB_PATH=data/monitoring.db
STALE_AFTER_SECONDS=90
OFFLINE_AFTER_SECONDS=900
DEFAULT_WINDOW_SECONDS=3600
MAX_INGEST_SAMPLES=500
MAX_REQUEST_BYTES=5000000
RETENTION_DAYS=30
CORS_ORIGINS=http://localhost:8080
APP_VERSION=1.0.0

# Optional authentication.  When AUTH_TOKEN is non-empty, every request
# must include ``Authorization: Bearer <token>`` (or ``X-Auth-Token``)
# except for /health and /ready.  Leave blank to disable.
AUTH_TOKEN=
AUTH_PROTECT_DOCS=false

# Optional notifications. Leave blank to disable delivery.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
SMTP_FROM=process-monitor@localhost
SMTP_TO=

# Agent
COLLECTOR_URL=http://127.0.0.1:8000
AGENT_HOSTNAME=
SAMPLE_INTERVAL_SECONDS=5
AGENT_BATCH_SIZE=100
AGENT_BUFFER_FILE=data/agent-buffer.jsonl
AGENT_MAX_BUFFER_BATCHES=200
